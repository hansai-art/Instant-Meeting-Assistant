# ============================================
# AI 會議顧問 - 環境變數設定
# ============================================
# 複製此檔案為 .env.local 並填入您的 API 金鑰
# cp .env.example .env.local

# ============================================
# Deepgram (語音轉文字) - 必需
# ============================================
# 請至 https://console.deepgram.com/ 申請 API 金鑰
DEEPGRAM_API_KEY=

# ============================================
# LLM 供應商 - 至少需要設定一個
# ============================================

# Claude (Anthropic) - 推薦
# 請至 https://console.anthropic.com/ 申請 API 金鑰
ANTHROPIC_API_KEY=

# OpenAI (GPT 系列)
# 請至 https://platform.openai.com/api-keys 申請 API 金鑰
OPENAI_API_KEY=

# Groq (低延遲)
# 請至 https://console.groq.com/keys 申請 API 金鑰
GROQ_API_KEY=

# Google Gemini (備選)
# 請至 https://aistudio.google.com/apikey 申請 API 金鑰
GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================
# 預設設定 (可選)
# ============================================

# 預設 LLM 供應商: claude | openai | groq | gemini
DEFAULT_LLM_PROVIDER=claude

# 預設模型 (如果不設定，會使用各供應商的預設模型)
# DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# ============================================
# Zeabur 部署說明
# ============================================
# 在 Zeabur 控制台中設定以上環境變數:
# 1. 進入專案的「Variables」設定頁面
# 2. 新增以上所需的環境變數
# 3. 重新部署專案以套用變更
#
# 注意：不要將包含實際 API 金鑰的 .env.local 檔案
# 提交到版本控制系統中
